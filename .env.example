# -----------------------------------------------------------------------------
# Rakt Response — environment variables
# Copy to .env.local for local development. Never commit real values.
# -----------------------------------------------------------------------------

# Public site URL (used for auth redirects and metadata). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (Project Settings → API). The anon/publishable key is safe
# to expose to browsers: Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# SERVER ONLY. Never prefix with NEXT_PUBLIC_ and never expose to the browser.
# Optional: enables anonymous blood-request submissions (rate limited by a
# salted hash of the client IP), the admin bootstrap script and account
# deletion processing. The app works without it (sign-in becomes required to
# submit a blood request and admins anonymise instead of deleting auth users).
SUPABASE_SERVICE_ROLE_KEY=

# SERVER ONLY. Random secret used to salt hashed client identifiers for rate
# limiting. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SALT=

# Optional map tiles (OpenStreetMap). Set to "false" to hide the optional map
# picker entirely. Respect the OSM tile usage policy for production traffic.
NEXT_PUBLIC_ENABLE_MAP=true
